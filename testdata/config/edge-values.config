# Grenzwerte der Java-Parser (nur Testwerte): Hex-Gleitkomma, dreiteilige Fenstergroesse, Vorzeichen,
# Leerraum-Werte, Unicode-Case-Folding, Locale mit Land. Reines ASCII mit Unicode-Escapes.
LOGO_ONLY_SIZE=0x1.8p4
MAINWINDOW_SIZE=800,600,700
MOBILE_NUMBER=00 43 664 1234567
PROXY_HOST=\u0020proxy.example.test
PROXY_PORT=+8080
PROXY_USER=test\u0020user
UPDATE_CHECK=fal\u017Fe
KEYSTORE_KEYPASS=\u0020\u0020
KEYSTORE_FILE=   
USE_MARKER=TRUE
USE_FIELDS=false
USE_PLACEHOLDER_SEARCH=TRUE
SIGNLOCALE=en_US
LOCALE=de_DE
LAST_SOURCE_DIRECTORY=   
EMBLEM=\u0020\t
BKU=NONE
SIGNATURE_NOTE=\u0020Mit f\u00FChrendem Leerzeichen\u0020
SIGNATURE_POSITION=AUTO
FIDO2_DEFAULT=yes
MOBILE_REMEMBER_PASSWORD=true
SAVE_FILE_POSTFIX=\u0020_s
