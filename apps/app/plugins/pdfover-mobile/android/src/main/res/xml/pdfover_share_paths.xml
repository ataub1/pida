<?xml version="1.0" encoding="utf-8"?>
<!-- „Teilen“/„Öffnen“ (shareFile/openFile): nur signierte Dokumente im Ausgabeordner der App
     (filesDir/Documents = Shell `mobile::ANDROID_OUTPUT_DIR`, CoreOptions::default_output_dir). Bewusst im
     internen App-Speicher und nicht in getExternalFilesDir(DIRECTORY_DOCUMENTS): den lesen unter
     Android 9/10 alle Apps mit Speicher-Berechtigung mit. -->
<paths>
    <files-path name="documents" path="Documents/" />
</paths>
