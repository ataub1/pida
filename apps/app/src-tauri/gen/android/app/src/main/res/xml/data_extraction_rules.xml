<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: weder Cloud-Sicherung noch Gerätewechsel übertragen App-Daten (Einstellungen,
     importierter PKCS#12-Keystore, verschlüsselte Secrets – deren Schlüssel im Android Keystore ohnehin
     gerätegebunden ist), Plan §7.7. -->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
  </device-transfer>
</data-extraction-rules>
