{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Berechtigungen des Hauptfensters: Kern-Bridge, Datei-Dialoge, Links (https/mailto), Drag & Drop.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-core-view",
    "allow-core-dispatch",
    "allow-app-info",
    "allow-open-log-dir",
    "allow-reveal-output",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "mailto:*" }]
    }
  ]
}
