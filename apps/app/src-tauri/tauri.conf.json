{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PIDA",
  "identifier": "at.asit.pida.app",
  "mainBinaryName": "pida",
  "version": "0.6.1",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "windows": {
      "staticVCRuntime": true
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "PIDA – PDF-Signatur ID Austria",
        "width": 860,
        "height": 900,
        "minWidth": 360,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: pida-render: http://pida-render.localhost https://pida-render.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "PIDA – PDF-Signatur mit ID Austria",
    "longDescription": "PIDA (PDF · ID · Austria) signiert PDF-Dokumente mit ID Austria, Chipkarte oder PKCS#12-Keystore (PAdES).",
    "publisher": "A-SIT",
    "homepage": "https://github.com/ataub1/pida",
    "copyright": "© 2026 A-SIT · EUPL-1.2",
    "license": "EUPL-1.2",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "mimeType": "application/pdf",
        "name": "PDF",
        "description": "PDF-Dokument",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "iOS": {
      "minimumSystemVersion": "16.0"
    },
    "android": {
      "minSdkVersion": 28
    }
  }
}
