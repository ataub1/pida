{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PDF-Over NG",
  "identifier": "at.pdf-over-ng",
  "mainBinaryName": "pdf-over-ng",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "PDF-Over NG",
        "width": 860,
        "height": 900,
        "minWidth": 360,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: pdfover-render: http://pdfover-render.localhost https://pdfover-render.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "PDF-Dokumente elektronisch signieren",
    "longDescription": "PDF-Over NG signiert PDF-Dokumente mit ID Austria, Bürgerkarte oder PKCS#12-Keystore (PAdES).",
    "copyright": "PDF-Over NG contributors, EUPL-1.2",
    "license": "EUPL-1.2",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "mimeType": "application/pdf",
        "name": "PDF",
        "description": "PDF-Dokument",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
