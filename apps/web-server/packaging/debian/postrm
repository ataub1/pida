#!/bin/sh
# PIDA Web: nach dem Entfernen systemd neu laden; „purge“ löscht auch den Aktivierungszustand
# (/etc/pida-web entfernt dpkg selbst, die Datei ist ein Conffile).
set -e
if [ "$1" = remove ] && [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
fi
if command -v deb-systemd-helper >/dev/null 2>&1; then
    if [ "$1" = remove ]; then
        deb-systemd-helper mask pida-web.service >/dev/null || true
    fi
    if [ "$1" = purge ]; then
        deb-systemd-helper purge pida-web.service >/dev/null || true
        deb-systemd-helper unmask pida-web.service >/dev/null || true
    fi
fi
if [ "$1" = purge ]; then
    rmdir /etc/pida-web 2>/dev/null || true
fi
exit 0
