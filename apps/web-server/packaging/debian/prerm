#!/bin/sh
# PIDA Web: Dienst vor dem Entfernen stoppen (bei einem Update startet postinst ihn neu).
set -e
if [ "$1" = remove ] && [ -d /run/systemd/system ]; then
    if command -v deb-systemd-invoke >/dev/null 2>&1; then
        deb-systemd-invoke stop pida-web.service >/dev/null || true
    else
        systemctl stop pida-web.service >/dev/null || true
    fi
fi
exit 0
